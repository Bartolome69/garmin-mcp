{
  "expo": {
    "name": "Daash",
    "slug": "daash",
    "owner": "bartolome69s-team",
    "scheme": "daash",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5ff0354e-22b6-417a-b6f3-9fc7e7278439"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.daash.app",
      "supportsTablet": false
    },
    "android": {
      "package": "run.daash.app",
      "adaptiveIcon": {
        "backgroundColor": "#161614",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161614",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#161614"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "5ff0354e-22b6-417a-b6f3-9fc7e7278439"
      }
    }
  }
}
