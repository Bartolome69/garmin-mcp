{
  "name": "daash-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/geist-mono": "~0.4.3",
    "@expo-google-fonts/source-serif-4": "~0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "expo": "58.0.24",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-notifications": "58.1.8",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "~0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^22.20.7",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "tokens": "python3 ../scripts/build_tokens.py",
    "tokens:check": "python3 ../scripts/build_tokens.py --check",
    "test": "jest",
    "lint:colours": "node scripts/check-colours.js",
    "check": "npm run tokens:check && npm run lint:colours && npm run typecheck && npm test -- --ci"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts?(x)",
          "<rootDir>/scripts/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/src/testing/setup.ts"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts?(x)",
          "<rootDir>/scripts/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/src/testing/setup.ts"
        ]
      }
    ],
    "testTimeout": 30000,
    "workerIdleMemoryLimit": "1200MB"
  }
}
