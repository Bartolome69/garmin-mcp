# Copy to mobile/.env (git-ignored) to change how the app runs. Expo reads EXPO_PUBLIC_* at bundle time.

# 1 = run on the sample runner's data (the London persona) everywhere: Today, Plan, post-run,
# Connections, the Coach's stand-in and the fake store, with a "Sample data" label on Today and You.
# Unset (the default) = sample data only in Expo Go when nobody is signed in, and in development builds.
EXPO_PUBLIC_DAASH_FIXTURE=1

# Optional, development only:
# EXPO_PUBLIC_DAASH_API=https://mcp.garmin.daash.run   # the server the app talks to
# EXPO_PUBLIC_DAASH_COACH=1                            # force the Coach on in a development build
# EXPO_PUBLIC_DAASH_PLUS=1                             # make the development build Plus
# EXPO_PUBLIC_DAASH_WATCH=fail                         # the stand-in watch fails its first send
